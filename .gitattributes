/# Auto detect text files and perform LF normalization
* text=auto
assets/databases/*.db filter=lfs diff=lfs merge=lfs -text
# Keep exact pinned bytes, including upstream license and model line endings.
assets/local_upscale/** -text -whitespace
assets/local_upscale/models/*.bin filter=lfs diff=lfs merge=lfs -text
assets/local_upscale/windows/*.exe filter=lfs diff=lfs merge=lfs -text
assets/local_upscale/windows/*.dll filter=lfs diff=lfs merge=lfs -text
assets/rag/windows/*.exe filter=lfs diff=lfs merge=lfs -text
